# Moltbot External API Keys
# ==========================
# Copy this file to .env and fill in your API keys
# SECURITY: Never commit .env to version control!
#
# Keys are loaded from environment variables only.
# They will NEVER appear in:
#   - Logs
#   - Prompts
#   - Disk storage
#   - Vector memory

# Claude API (Anthropic)
# Get from: https://console.anthropic.com/
# Use for: Deep reasoning, architecture analysis, codebase review
CLAUDE_API_KEY=

# OpenAI API
# Get from: https://platform.openai.com/
# Use for: Summarization, user-facing language, content rewriting
OPENAI_API_KEY=

# Manus API (Computer Use)
# Use for: UI automation with explicit user approval
# WARNING: Requires user approval before each session
MANUS_API_KEY=
